# ============================================
# 环境变量模板
# 复制为 .env 并填入真实值
# ============================================

# ---- 服务器 ----
PORT=4001
NODE_ENV=production

# ---- PostgreSQL 数据库 (Railway 自动提供 DATABASE_URL) ----
# 本地开发时使用下面的独立变量:
# DATABASE_URL=postgresql://user:password@host:5432/chat_app
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chat_app
# DB_USER=postgres
# DB_PASSWORD=postgres

# ---- JWT 鉴权 ----
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# ---- 微信 OAuth ----
# 从微信公众平台获取: https://mp.weixin.qq.com/
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ---- CodeBuddy Agent SDK ----
# 如果使用 Agent SDK 需要 API Key
# CODEBUDDY_API_KEY=your_api_key

# ---- WebRTC TURN 服务器 (生产必备) ----
# 自建 coturn 或使用第三方 TURN 服务
# TURN_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=username
# TURN_CREDENTIAL=password
